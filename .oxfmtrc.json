{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [],

  "semi": true,
  "trailingComma": "es5",
  "bracketSameLine": false,

  // prettier-plugin-tailwindcss is built-in to oxfmt, so we can use the "sortTailwindcss" option
